# ==============================================================================
# CipherShare Environment Configuration Example
# Copy this file to .env (or backend/.env) and configure appropriate values.
# NEVER commit real production secrets, API keys, or private keys.
# ==============================================================================

# Flask Server Configuration
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=True

# JWT Token Configuration
JWT_SECRET_KEY=change-this-to-a-secure-jwt-signing-key
JWT_EXPIRY_HOURS=8

# Database Configuration
# Leave blank to use local SQLite (instance/ciphershare.db) for development.
# For Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Storage Provider Configuration: "local" or "supabase"
STORAGE_TYPE=local

# Supabase Storage Configuration (Required only if STORAGE_TYPE=supabase)
# NOTE: The service-role key must exist ONLY on the Flask backend, NEVER in frontend code!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_BUCKET=ciphershare-encrypted-files

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cryptographic and File Limits
MAX_FILE_SIZE_BYTES=26214400 # 25 MB

